  m_TableData:
  - m_Id: 913048592384
    m_Localized: "\uB124\uD2B8\uC6CC\uD06C \uC11C\uBC84\uB97C \uC900\uBE44\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4.\n\uC778\uD130\uB137 \uC5F0\uACB0 \uC0C1\uD0DC\uB97C
      \uD655\uC778\uD558\uACE0\n\uC7A0\uC2DC \uD6C4 \uB2E4\uC2DC \uC2DC\uB3C4\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 913136672768
    m_Localized: "\uAC8C\uC784 \uC11C\uBC84\uB97C \uC2DC\uC791\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uC774\uBBF8
      \uB2E4\uB978 \uC11C\uBC84\uAC00 \uC791\uB3D9 \uC911\uC774\uAC70\uB098 \n\uB124\uD2B8\uC6CC\uD06C
      \uC124\uC815\uC5D0 \uC624\uB958\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 913140867072
    m_Localized: "\uB124\uD2B8\uC6CC\uD06C \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC838\n\uC11C\uBC84\uAC00
      \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uBA54\uC778 \uBA54\uB274\uB85C
      \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4082713485312
    m_Localized: "\uCC38\uC5EC \uCF54\uB4DC\uAC00 \uC62C\uBC14\uB974\uC9C0 \uC54A\uAC70\uB098\n\uBC29\uC744
      \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uB2E4\uC2DC \uD655\uC778\uD574
      \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4082726068224
    m_Localized: "\uB124\uD2B8\uC6CC\uD06C \uBAA8\uB4C8\uC744 \uC2DC\uC791\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4.\n\uC571\uC744 \uC7AC\uC2E4\uD589\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4082730262528
    m_Localized: "\uC11C\uBC84 \uC5F0\uACB0\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4.\n\uBE44\uBC00\uBC88\uD638\uAC00
      \uD2C0\uB838\uAC70\uB098\n\uC11C\uBC84 \uC0C1\uD0DC\uAC00 \uBD88\uC548\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4082730262529
    m_Localized: "\uC11C\uBC84\uC640\uC758 \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC84C\uC2B5\uB2C8\uB2E4.\n\uBA54\uC778
      \uBA54\uB274\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 24796480921600
    m_Localized: "\uC815\uB9D0\uB85C \uC138\uC158\uC744 \uC885\uB8CC\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\uD638\uC2A4\uD2B8\uAC00
      \uB098\uAC00\uBA74 \uD300\uC774 \uD574\uCCB4\uB418\uACE0\n\uBAA8\uB4E0 \uD300\uC6D0\uC758
      \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 24796556419072
    m_Localized: "\uC815\uB9D0\uB85C \uBC29\uC744 \uB098\uAC00\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 24796556419073
    m_Localized: "\uD638\uC2A4\uD2B8\uC640\uC758 \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC838\n\uD300\uC774
      \uD574\uCCB4\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD655\uC778\uC744 \uB204\uB974\uBA74\n\uD0C0\uC774\uD2C0
      \uD654\uBA74\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 248587997368320
    m_Localized: "\uD300\uC6D0\uC774 \uAC8C\uC784\uC5D0\uC11C \uC774\uD0C8\uD558\uC5EC\n\uB354
      \uC774\uC0C1 \uC9C4\uD589\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uD655\uC778\uC744
      \uB204\uB974\uBA74\n\uD0C0\uC774\uD2C0 \uD654\uBA74\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
