  m_TableData:
  - m_Id: 284360171520
    m_Localized: "\uC624\uB79C \uC138\uC6D4 \uB3D9\uC548,\n\uC5F0\uAE08\uC220\uC740
      \uC138\uC0C1\uC5D0 \uB4DC\uB7EC\uB098\uC9C0 \uC54A\uC740 \uCC44\n\uBE44\uBC00\uC2A4\uB7FD\uAC8C
      \uC804\uD574\uC838 \uC628 \uAE30\uC220\uC774\uC5C8\uB2E4.\n\uADF8\uAC83\uC740
      \uB2E8\uC21C\uD55C \uC9C0\uC2DD\uC774 \uC544\uB2C8\uB77C,\n\uC704\uD5D8\uD55C
      \uC0C1\uD669\uC5D0\uC11C \uC0B4\uC544\uB0A8\uACE0\n\uC7AC\uB09C\uC5D0 \uB9DE\uC11C\uAE30
      \uC704\uD55C \uAC15\uB825\uD55C \uD798\uC774\uC5C8\uB2E4.\n\n\uD558\uC9C0\uB9CC
      \uADF8 \uD798\uC744\n\uC798\uBABB\uB41C \uAE38\uC5D0 \uC4F0\uB824\uB294 \uC790\uB4E4\uB3C4
      \uC788\uC5C8\uB2E4.\n\uAE08\uC9C0\uB41C \uC5F0\uAE08\uC220\uC744 \uD0D0\uD558\uB294
      \uC9D1\uB2E8,\n\uC554\uD751 \uC5F0\uAE08\uC220\uC0AC\uB4E4.\n\n\uADF8\uB4E4\uC740
      \uB4A4\uD2C0\uB9B0 \uD798\uC73C\uB85C \uC138\uC0C1 \uACF3\uACF3\uC5D0 \uD63C\uB780\uC744
      \uD37C\uB728\uB838\uACE0,\n\uD3C9\uD654\uB86D\uB358 \uB9C8\uC744\uB4E4\uB9C8\uC800
      \uC704\uD611\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4.\n\n\uC774 \uC0AC\uD0DC\uB97C
      \uB9C9\uAE30 \uC704\uD574,\n\uD2B9\uC218\uD55C \uC7AC\uB09C\uC5D0 \uB300\uC751\uD558\uB3C4\uB85D
      \uD6C8\uB828\uBC1B\uC740\n\uB124 \uBA85\uC758 \uC5F0\uAE08\uC220 \uC7A5\uC778\uC774
      \uC18C\uC9D1\uB41C\uB2E4.\n\uADF8\uB4E4\uC758 \uBAA9\uD45C\uB294 \uB2E8 \uD558\uB098.\n\uB2E4\uAC00\uC62C
      \uC704\uD611\uC5D0 \uB9DE\uC11C\uACE0,\n\uC554\uD751 \uC5F0\uAE08\uC220\uC0AC\uB4E4\uC758
      \uACC4\uD68D\uC744 \uC800\uC9C0\uD558\uB294 \uAC83.\n\n\uC774\uC81C, \uC5F0\uAE08\uC220
      \uC7A5\uC778\uC73C\uB85C\uC11C\uC758 \n\uCCAB \uD6C8\uB828\uC774 \uC2DC\uC791\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
